DATABASE_URL=postgres://user:password@localhost:5432/ai_books
JWT_SECRET=change_me_to_a_long_random_string

# Ключ из Google AI Studio (бесплатно, без карты): https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Необязательно: конкретная модель бесплатного тира. По умолчанию gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
# Необязательно: пауза между запросами к Gemini в мс (защита от 429 на free tier)
GEMINI_MIN_DELAY_MS=4500

PORT=3000
